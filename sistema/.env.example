# Plantilla de configuración de la base de datos compartida (Supabase).
#
# Para usarla: copia este archivo con el nombre .env (en esta misma carpeta)
# y escribe la contraseña de la base de datos en DB_PASSWORD.
# El archivo .env NO se sube a GitHub: así la contraseña no queda pública.
#
# Si no existe el .env, el sistema usa SQLite local como antes.

DB_NAME=postgres
DB_USER=postgres.jwpksvnvmlyrsbtdtyjg
DB_PASSWORD=
DB_HOST=aws-1-sa-east-1.pooler.supabase.com
DB_PORT=5432
